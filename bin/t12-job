#!/usr/bin/env python3
"""Run one profile job and write a findings file."""

import argparse
import json
import os

parser = argparse.ArgumentParser(prog="t12-job", description=__doc__)
parser.add_argument("--home", required=True)
parser.add_argument("--name", required=True)
args = parser.parse_args()

job_dir = os.path.join(os.path.abspath(args.home), "jobs", args.name)
os.makedirs(job_dir, exist_ok=True)
with open(os.path.join(job_dir, "findings-1.json"), "w", encoding="utf-8") as fh:
    json.dump({"findings": []}, fh)
