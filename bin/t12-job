#!/usr/bin/env python3
"""Run one profile job and write a findings file."""

import argparse
import json
import os
import subprocess

parser = argparse.ArgumentParser(prog="t12-job", description=__doc__)
parser.add_argument("--home", required=True)
parser.add_argument("--name", required=True)
args = parser.parse_args()

job_dir = os.path.join(os.path.abspath(args.home), "jobs", args.name)
os.makedirs(job_dir, exist_ok=True)
with open(os.path.join(args.home, "config.json"), encoding="utf-8") as fh:
    config = json.load(fh)
commit = subprocess.run(
    ["git", "-C", config["repo"], "rev-parse", "refs/heads/" + config.get("trunk", "main")],
    check=True, capture_output=True, text=True,
).stdout.strip()
shown = subprocess.run(
    ["git", "-C", config["repo"], "show", commit + ":.t12/project.json"],
    capture_output=True, text=True,
)
jobs = json.loads(shown.stdout).get("jobs", []) if shown.returncode == 0 else []
job = next((j for j in jobs if j.get("name") == args.name), {})
findings = []
if "command" in job:
    result = subprocess.run(job["command"], cwd=config["repo"])
    if result.returncode != 0:
        findings.append({"fingerprint": "check:command"})
seq = 1
while os.path.exists(os.path.join(job_dir, "findings-%d.json" % seq)):
    seq += 1
findings_path = os.path.join(job_dir, "findings-%d.json" % seq)
with open(findings_path, "w", encoding="utf-8") as fh:
    json.dump({"commit": commit, "findings": findings}, fh)
if findings:
    raise SystemExit(1)
