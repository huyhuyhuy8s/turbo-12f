#!/usr/bin/env python3
"""Run one profile job and write a findings file."""

import argparse
import json
import os
import subprocess
import sys
import time

parser = argparse.ArgumentParser(prog="t12-job", description=__doc__)
parser.add_argument("--home", required=True)
parser.add_argument("--name", required=True)
args = parser.parse_args()

home = os.path.abspath(args.home)
job_dir = os.path.join(home, "jobs", args.name)
os.makedirs(job_dir, exist_ok=True)
with open(os.path.join(args.home, "config.json"), encoding="utf-8") as fh:
    config = json.load(fh)
commit = subprocess.run(
    ["git", "-C", config["repo"], "rev-parse", "refs/heads/" + config.get("trunk", "main")],
    check=True, capture_output=True, text=True,
).stdout.strip()
shown = subprocess.run(
    ["git", "-C", config["repo"], "show", commit + ":.t12/project.json"],
    capture_output=True, text=True,
)
jobs = json.loads(shown.stdout).get("jobs", []) if shown.returncode == 0 else []
job = next((j for j in jobs if j.get("name") == args.name), None)
if job is None:
    print("unknown job %r; available jobs: %s" % (args.name, ", ".join(j.get("name", "") for j in jobs)), file=sys.stderr)
    raise SystemExit(2)


def run_adapter(job, repo, commit, home, job_dir):
    """Run the job's adapter and return its findings; exit 2 if it fails or misbehaves."""
    adapter_name = job["adapter"]
    adapter = os.path.join(home, "adapters", adapter_name + ".py")
    if not os.path.exists(adapter):
        adapter = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "adapters", adapter_name + ".py")
    out_path = os.path.join(job_dir, "adapter-out.tmp")
    try:
        subprocess.run(
            ["python3", adapter, "job", "--job", json.dumps(job), "--repo", repo, "--commit", commit,
             "--home", home, "--out", out_path],
            check=True, stdin=subprocess.DEVNULL,
        )
        with open(out_path, encoding="utf-8") as fh:
            adapter_findings = json.load(fh)["findings"]
        if not isinstance(adapter_findings, list):
            raise ValueError("findings is not a list")
        for f in adapter_findings:
            if not isinstance(f.get("fingerprint"), str) or not f["fingerprint"]:
                raise ValueError("finding without fingerprint")
        return adapter_findings
    except (subprocess.CalledProcessError, OSError, ValueError, KeyError, TypeError, AttributeError):
        raise SystemExit(2)
    finally:
        if os.path.exists(out_path):
            os.remove(out_path)


findings = []
kind = None
if "adapter" in job:
    kind = "adapter"
    findings = run_adapter(job, config["repo"], commit, home, job_dir)
if "command" in job:
    try:
        result = subprocess.run(job["command"], cwd=config["repo"], capture_output=True, text=True,
                                errors="replace", timeout=job.get("timeout_s"))
    except subprocess.TimeoutExpired:
        findings.append({"fingerprint": "check:command", "detail": "command timed out after %ss" % job["timeout_s"]})
    except OSError as exc:
        findings.append({"fingerprint": "check:command", "detail": "command could not be run: %s" % exc})
    else:
        if result.returncode != 0:
            findings.append({"fingerprint": "check:command", "detail": result.stdout + result.stderr})
seq = 1
while os.path.exists(os.path.join(job_dir, "findings-%d.json" % seq)):
    seq += 1
findings_path = os.path.join(job_dir, "findings-%d.json" % seq)
with open(findings_path, "w", encoding="utf-8") as fh:
    record = {"commit": commit, "findings": findings}
    if kind:
        record.update({"job": args.name, "kind": kind, "at": int(time.time())})
    json.dump(record, fh)
print(findings_path)
if findings:
    raise SystemExit(1)
